pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
	flws={}
	for i=1,200 do
			add(flws,make_flower())
	end
end

function _update()

end

function _draw()
		cls(3)
		for f in all(flws) do
		  draw_flower(f)
		end
end
-->8
function make_flower()
  flw={
  		x=flr(rnd(128)),
    y=flr(rnd(128)),
    r=rnd(10),
    c=rnd({2,9,10}),
    cp=rnd({7,8,9,10,12,14}),
  }
  return flw
end

function draw_flower(f)
  circfill(f.x+f.r, f.y, f.r, f.cp)
  circfill(f.x-f.r, f.y, f.r, f.cp)
  circfill(f.x, f.y+f.r, f.r, f.cp)
  circfill(f.x, f.y-f.r, f.r, f.cp)
 
  circfill(f.x, f.y, f.r, f.c)
  
end
