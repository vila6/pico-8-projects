pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
mx = stat(32)
my = stat(33)

cx = 47
cy = 47
function _init()
		poke(24365,1) -- enable mouse
end

function _update()
		mx = stat(32)
		my = stat(33)
end

function _draw()
		cls(5)
		circfill(50,50,10,7)
		circfill(50,70,15,7)
		dirx = mx - cx
		diry = my - cy
		
		dirx = dirx/15
		diry = diry/15
		spr(1, cx+dirx*2, cy+diry*2)
		circfill(mx, my, 3, 10)
end
__gfx__
