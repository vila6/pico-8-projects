pico-8 cartridge // http://www.pico-8.com
version 43
__lua__
function _init()
 p={x=64,
				y=64,
				spd=3,
				jspd=3,
				dspd=5,
				v={x=0,y=0},
				d=5
			}
	enemies={}
	add(enemies, make_enemy())
	g=0.1
end

function _update60()		
		p.v.x *= 0.95
		if btnp(⬅️) do
				p.v.y = 0
				p.v.x = -p.spd
				p.d-=1
		end
		if btnp(➡️) do
				p.v.y = 0
				p.v.x = p.spd
				p.d-=1
		end
		if btnp(⬆️) do
				p.v.y = -p.jspd
				
				p.d-=1
		end
		
		if btnp(⬇️) do
				p.v.x = 0
				p.v.y = p.dspd
		end
		if abs(p.v.x)<1 do
				p.v.y += g
		end
		
	for e in all(enemies) do
		if abs(p.x-e.x) <= 16
		and abs(p.y-e.y)<=8 do
			p.v.x=0
			if p.v.y>0 do
			 p.d+=3
			 p.d=min(p.d, 10)
			 p.v.y=-p.v.y/2
			 del(enemies,e)
				add(enemies,make_enemy())
			end
		end
	end
	
		p.x += p.v.x
		p.y += p.v.y
end

function _draw()
		cls()
		spr(1,p.x,p.y)
		for e in all(enemies) do
		  draw_enemy(e)
		end
		for i=1,p.d do
				circfill(i*5, 3, 2, 10)
		end
end
-->8
function make_enemy()
		e={x=rnd(128),
					y=21+rnd(86),
				}
	 return e
end

function draw_enemy(e)
  spr(2,e.x-8,e.y)
  spr(3,e.x,e.y)
  spr(2,e.x+8,e.y,1,1,true)
end
